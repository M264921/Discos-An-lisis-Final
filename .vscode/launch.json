{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MingoMedia: asistente Windows (recursos preparados)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/mingomedia_desktop.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "CLI Python: ayuda",
      "type": "debugpy",
      "request": "launch",
      "module": "discos_analisis",
      "args": ["--help"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "PowerShell: comprobar sintaxis del repositorio",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/tools/check-powershell-syntax.ps1",
      "cwd": "${workspaceFolder}",
      "args": []
    }
  ]
}
